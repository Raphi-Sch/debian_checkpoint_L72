ImageSupportWdt=0
activeConfig=1
activePartition=1
adsl_offset=0x6A080000
adsl_size=0x100000
arch=arm
autoload=n
baudrate=115200
blob_offset=CP_BLOB_OFFSET
blob_size=0x40000
board=alpine_db_s2
board_name=alpine_db_s2
bootImage=run set_bootargs ;run tf1_image$activePartition
boot_instance_active=0
boot_instance_non_active=1
boot_partition_size=0x300000
bootaddr=0x8000200
bootargs=boardFlavor=alpine_db_s2 quiet console=ttyS0,115200 noExtPorts= cp_net_config=3,(00:1C:7F:7D:5E:F5)(00:1C:7F:7D:5E:F6)(00:1C:7F:7D:5E:F7) maxcpus=3 uboot_ver=90 pci=pcie_bus_perf mem=2046M ramoops.mem_address=0x7fe00000 ramoops.mem_size=0x100000 ramoops.record_size=0x10000
bootargsextra=mem=2046M ramoops.mem_address=0x7fe00000 ramoops.mem_size=0x100000 ramoops.record_size=0x10000
bootargshd=run rootargshd; setenv bootargs $rootargs pci=pcie_bus_perf $bootargsextra; printenv bootargs
bootargsnand=run rootargsnand; setenv bootargs $rootargs pci=pcie_bus_perf $bootargsextra; printenv bootargs
bootargsnfs=run rootargsnfs; setenv bootargs $rootargs pci=pcie_bus_perf $bootargsextra; printenv bootargs
bootcmd=run tf1_image1 
bootdelay=2
bootenv_offset=al_config_env_offset_get()
bootenv_size=CONFIG_ENV_SIZE_FULL
bootext4=lcd_print "Loading OS...";scsi init; ext4load scsi ${ext4dev}:${ext4part} $loadaddr ${ext4dir}${dt_filename};if test $? -ne 0; then run fail; exit; fi;if test ${dt_is_from_toc} != 1; then; else flash_contents_obj_read_mem $loadaddr_dt $loadaddr;if test $? -ne 0; then run fail; exit; fi;fi;ext4load scsi ${ext4dev}:${ext4part} $loadaddr ${ext4dir}uImage;if test $? -ne 0; then run fail; exit; fi;fdt addr $loadaddr_dt;bootm $loadaddr - $fdtaddr;run fail; exit
bootloader_version=90
bootnand=lcd_print "Loading OS...";nand set_partition_offset $nand_pt_addr_kernel;nand read $loadaddr $nand_pt_addr_kernel 4;setenvmem filesize $loadaddr;incenv filesize 4;nand read $loadaddr $nand_pt_addr_kernel $filesize;nand set_partition_offset $nand_pt_addr_al_boot;bootm $loadaddr_payload - $fdtaddr;lcd_print Failed!
bootnandmulti=run kernel_select;if test $kernel_selected -ne 0; then run bootnand; fi
boottftp=lcd_print "Loading OS...";tftpboot $loadaddr ${tftpdir}${dt_filename};if test $? -ne 0; then run fail; exit; fi;if test ${dt_is_from_toc} != 1; then; else flash_contents_obj_read_mem $loadaddr_dt $loadaddr;if test $? -ne 0; then run fail; exit; fi;fi;tftpboot $loadaddr ${tftpdir}uImage;if test $? -ne 0; then run fail; exit; fi;fdt addr $loadaddr_dt;bootm $loadaddr - $fdtaddr;run fail; exit
bootupd=is_nand_boot; if test $? -eq 0; then run bootupdspi; else; run bootupdnand; fi
bootupdnand=lcd_print "Updating al-boot" "to NAND"; tftpboot $loadaddr ${tftpdir}boot.img; if test $? -ne 0; then run fail; exit; fi;nand set_partition_offset $nand_pt_addr_al_boot;nand erase.spread $nand_pt_addr_al_boot $filesize; nand write $loadaddr $nand_pt_addr_al_boot $filesize; lcd_print "Done"
bootupdnandy=lcd_print "Updating al-boot" "to NAND"; echo >> Use YModem to upload the boot image binary...;loady $loadaddr;if test $? -ne 0; then run fail; exit; fi;nand set_partition_offset $nand_pt_addr_al_boot;nand erase.spread $nand_pt_addr_al_boot $filesize; nand write $loadaddr $nand_pt_addr_al_boot $filesize; lcd_print "Done"
bootupdspi=lcd_print "Updating al-boot" "to SPI"; tftpboot ${loadaddr} ${tftpdir}boot.img; if test $? -ne 0; then run fail; exit; fi;sf probe; sf erase 0 +${filesize}; sf write ${loadaddr} 0 ${filesize}; echo bootupd done;echo Notice: Changes in default environment variables will only take effect once the;echo environment variables are deleted from flash using the 'delenv' script;lcd_print "Done"
bootupdspiy=lcd_print "Updating al-boot" "to SPI"; echo >> Use YModem to upload the boot image binary...;loady ${loadaddr};if test $? -ne 0; then run fail; exit; fi;sf probe; sf erase 0 +${filesize}; sf write ${loadaddr} 0 ${filesize}; echo bootupd done;echo Notice: Changes in default environment variables will only take effect once the;echo environment variables are deleted from flash using the 'delenv' script;lcd_print "Done"
bootupdy=is_nand_boot; if test $? -eq 0; then run bootupdspiy;else; run bootupdnandy; fi
burn_default=nand set_partition_offset $default_image_offset; nand write.e $loadaddr $default_image_offset $filesize; setenv default_image_size $filesize ; saveenv
burn_primary=nand set_partition_offset $primary_offset ; nand write.e $loadaddr $primary_offset $filesize
change_config=run switch_config set_bootcmd_normal tf1_image$activePartition
config_back_erase=nand set_partition_offset $config_back_offset ; nand erase $config_back_offset $config_back_size
confirm_boot=run set_bootcmd_normal bootcmd
cp_boot_mode=3
cp_boot_no_console_output=0
cp_console_str=ttyS0,115200
cp_quiet=maintenance
cpu=armv7
cvos_tags=0x01000000
cvos_tags_seed_a=0x01000004
cvos_tags_seed_b=0x01000008
cvos_tags_validate=mw.l ${cvos_tags} 0xcf05cf05
default_image_offset=0x1DB80000
default_image_size=8e00000
delenv=is_nand_boot; if test $? -eq 0; then run delenvspi; else; run delenvnand; fi
delenvnand=lcd_print "Deleting env..."; nand erase ${env_offset} 2000; if test -n ${env_offset_redund}; then nand erase ${env_offset_redund} 2000; fi;lcd_print "Done"
delenvspi=lcd_print "Deleting env..."; sf probe; sf erase ${env_offset} +2000;if test -n ${env_offset_redund}; then sf erase ${env_offset_redund} +2000;fi;lcd_print "Done"
dmz_mac_addr=00:1C:7F:7D:5E:F7
dsl2_mac_addr=00:00:00:00:00:00
dsl3_mac_addr=00:00:00:00:00:00
dsl_action=3
dsl_mac_addr=00:00:00:00:00:00
dt_filename=dt.img
dt_is_from_toc=1
dt_location=80000
dtupd=is_nand_boot; if test $? -eq 0; then run dtupdspi; else; run dtupdnand; fi
dtupdnand=lcd_print "Updating DT" "to NAND"; tftpboot $loadaddr_dt ${tftpdir}${dt_filename};if test $? -ne 0; then run fail; exit; fi;if test ${dt_is_from_toc} != 1; then; else flash_contents_obj_read_mem $loadaddr $loadaddr_dt;if test $? -ne 0; then run fail; exit; fi;fi;nand set_partition_offset $nand_pt_addr_al_boot;nand erase.spread ${dt_location} 10000; nand write ${loadaddr_dt} ${dt_location} 10000; lcd_print "Done"
dtupdnandy=lcd_print "Updating DT" "to NAND"; echo >> Use YModem to upload the device tree binary...;loady $loadaddr_dt;if test $? -ne 0; then run fail; exit; fi;if test ${dt_is_from_toc} != 1; then; else flash_contents_obj_read_mem $loadaddr $loadaddr_dt;if test $? -ne 0; then run fail; exit; fi;fi;nand set_partition_offset $nand_pt_addr_al_boot;nand erase.spread ${dt_location} 10000; nand write ${loadaddr_dt} ${dt_location} 10000; lcd_print "Done"
dtupdspi=lcd_print "Updating DT" "to SPI"; tftpboot $loadaddr_dt ${tftpdir}${dt_filename};if test $? -ne 0; then run fail; exit; fi;if test ${dt_is_from_toc} != 1; then; else flash_contents_obj_read_mem $loadaddr $loadaddr_dt;if test $? -ne 0; then run fail; exit; fi;fi;sf probe; sf erase ${dt_location} +${filesize}; sf write ${loadaddr_dt} ${dt_location} ${filesize};echo dtupd done;lcd_print "Done"
dtupdspiy=lcd_print "Updating DT" "to SPI"; echo >> Use YModem to upload the device tree binary...;loady $loadaddr_dt;if test $? -ne 0; then run fail; exit; fi;if test ${dt_is_from_toc} != 1; then; else flash_contents_obj_read_mem $loadaddr $loadaddr_dt;if test $? -ne 0; then run fail; exit; fi;fi;sf probe; sf erase ${dt_location} +${filesize}; sf write ${loadaddr_dt} ${dt_location} ${filesize}; echo dtupd done;lcd_print "Done"
dtupdy=is_nand_boot; if test $? -eq 0; then run dtupdspiy; else; run dtupdnandy; fi
eepromupd=confirm_msg "Perform EEPROM update? [y/n] ";if test $? -ne 0; then exit; fi;tftpboot ${tftpdir}eeprom.bin;if test $? -ne 0; then exit; fi;i2c probe ${pld_i2c_addr};if test $? -ne 0; then exit; fi;i2c write $fileaddr ${pld_i2c_addr} 0.2 $filesize;if test $? -ne 0; then exit;fi;echo eepromupd done
eepromupdy=confirm_msg "Perform EEPROM update? [y/n] ";if test $? -ne 0; then exit; fi;echo >> Use YModem to upload the EEPROM binary...;loady $loadaddr;if test $? -ne 0; then exit; fi;i2c probe ${pld_i2c_addr};if test $? -ne 0; then exit; fi;i2c write $loadaddr ${pld_i2c_addr} 0.2 $filesize;if test $? -ne 0; then exit;fi;echo eepromupdy done
enaAutoRecovery=yes
env_offset=280000
env_offset_redund=2c0000
eth1addr=00:1C:7F:7D:5E:F7
eth2addr=00:1C:7F:7D:5E:F6
eth3addr=be:d8:4f:90:3a:5d
ethact=al_eth1
ethaddr=00:1C:7F:7D:5E:F5
ethprime=al_eth1
ext4dev=0
ext4dir=boot/
ext4part=1
fail=echo Failed!; lcd_print "Failed!"
fdtaddr=3b2c008
fileaddr=8000000
filesize=8e00000
flash_end=0x80000000
flash_erase=run seattle_flash_erase;run storage_erase
flash_erase_except_default=run primary_part_erase secondary_part_erase logs_erase storage_erase
flash_erase_for_image_burn=run storage_erase
flash_erase_size=0x1ff00000
flash_secondary_erase=run secondary_part_erase;run logs_erase
format_fs_parts=0
fwtmp_dir_size=40
fwupd=tftpboot ${tftpdir}uboot_script_fw_update.bin;source ${loadaddr}
hardware_capabilities=1
hdroot=/dev/sda1
hw_mac_addr=00:1C:7F:7D:5E:F5
image_size=0xC400000
images_back_erase=nand set_partition_offset $images_back_offset ; nand erase $images_back_offset $images_back_size
ipaddr=192.168.1.1
kernel_rename_1=editenv nand_pt_desc_kernel_1;saveenv
kernel_rename_2=editenv nand_pt_desc_kernel_2;saveenv
kernel_select=setenv kernel_selected 0;setenv bootmenu_0 ${nand_pt_desc_kernel_1}=run kernel_select_1;setenv bootmenu_1 ${nand_pt_desc_kernel_2}=run kernel_select_2;bootmenu
kernel_select_1=setenv nand_pt_addr_kernel ${nand_pt_addr_kernel_1};setenv kernel_selected 1
kernel_select_2=setenv nand_pt_desc_kernel ${nand_pt_desc_kernel_2};setenv nand_pt_addr_kernel ${nand_pt_addr_kernel_2};setenv nand_pt_desc_kernel_2 ${nand_pt_desc_kernel_1};setenv nand_pt_addr_kernel_2 ${nand_pt_addr_kernel_1};setenv nand_pt_desc_kernel_1 ${nand_pt_desc_kernel};setenv nand_pt_addr_kernel_1 ${nand_pt_addr_kernel};saveenv;setenv kernel_selected 2
kernel_size=0x01000000
kernelupd=lcd_print "Updating kernel...";tftpboot $loadaddr_payload ${tftpdir}uImage;if test $? -ne 0; then run fail; exit; fi;nand set_partition_offset $nand_pt_addr_kernel;mw.l $loadaddr $filesize;incenv filesize 4;nand erase.spread $nand_pt_addr_kernel $filesize;nand write $loadaddr $nand_pt_addr_kernel $filesize;nand set_partition_offset $nand_pt_addr_al_boot;echo kernelupd done;lcd_print "Done"
lan10_mac_addr=00:1C:7F:7D:5E:F6
lan11_mac_addr=00:1C:7F:7D:5E:F6
lan12_mac_addr=00:1C:7F:7D:5E:F6
lan13_mac_addr=00:1C:7F:7D:5E:F6
lan14_mac_addr=00:1C:7F:7D:5E:F6
lan15_mac_addr=00:1C:7F:7D:5E:F6
lan16_mac_addr=00:1C:7F:7D:5E:F6
lan1_mac_addr=00:1C:7F:7D:5E:F6
lan2_mac_addr=00:1C:7F:7D:5E:F6
lan3_mac_addr=00:1C:7F:7D:5E:F6
lan4_mac_addr=00:1C:7F:7D:5E:F6
lan5_mac_addr=00:1C:7F:7D:5E:F6
lan6_mac_addr=00:1C:7F:7D:5E:F6
lan7_mac_addr=00:1C:7F:7D:5E:F6
lan8_mac_addr=00:1C:7F:7D:5E:F6
lan9_mac_addr=00:1C:7F:7D:5E:F6
loadaddr=0x08000000
loadaddr_dt=0x07000000
loadaddr_payload=0x08001000
loadaddr_rootfs_chk=0x07000000
logs_erase=setenv format_fs_parts 1; saveenv
logs_offset=0x29F80000
logs_size=0x40000000
marketing_capabilities=1
marketing_name=770
mgmt_opq=xkdQy46ic7E=:Q/6Z1IKemxU=:H2Zew1k/sTo=
mgmt_signature=hxnEyjd6oyHewySJ7QYqcUB5PSyk2zc3g+pqy5RcEHDlfMmranr3Z9PgQpCyHwbLMfX/cFtCGlduNLd5LIm1Zg==
mgmt_signature_ver=1
nand_pt_addr_al_boot=0x0
nand_pt_addr_fs=0x01000000
nand_pt_addr_kernel=0x00400000
nand_pt_addr_kernel_1=0x00400000
nand_pt_addr_kernel_2=0x00a00000
nand_pt_desc_kernel_1=Test kernel A
nand_pt_desc_kernel_2=Test kernel B
nand_pt_size_al_boot=0x00400000
nand_pt_size_fs=0x3f000000
nand_pt_size_kernel=0x00c00000
nfsrootdir=/srv/root/
num_cores_param=maxcpus=3
pld_i2c_addr=57
preboot=mw.l 0xFD860204 0xF0000000;mw.l 0xFD860204 0xF1000000;mw.l 0xFD860304 0xE0000000;mw.l 0xFD860304 0xE1000000
preset=0
preset_cfg_offset=0x69F80000
preset_cfg_size=0x100000
primary_offset=0x380000
primary_part_erase=nand set_partition_offset $primary_offset ; nand erase $primary_offset $rootfs_size
read_default=nand set_partition_offset $default_image_offset ; nand read.e $loadaddr $default_image_offset $default_image_size
recoverFlag=0
recover_boot=run switch_active ; run set_recover_flags ; run set_bootcmd_normal bootcmd
reset_cores_num=setenv cpnumcores "" ; saveenv
return_to_default=run set_bootcmd_return_default flash_erase_except_default read_default write_default_to_primary reset_cores_num set_bootcmd_normal
rootargs=boardFlavor=alpine_db_s2 quiet console=ttyS0,115200 noExtPorts= cp_net_config=3,(00:1C:7F:7D:5E:F5)(00:1C:7F:7D:5E:F6)(00:1C:7F:7D:5E:F7) maxcpus=3 uboot_ver=90
rootargshd=setenv rootargs root=${hdroot} rw
rootargsnand=setenv rootargs boardFlavor=${board} ${cp_quiet} console=${cp_console_str} noExtPorts=${noExtPorts} cp_net_config=3,(${hw_mac_addr})(${lan1_mac_addr})(${dmz_mac_addr}) ${num_cores_param} uboot_ver=${bootloader_version}
rootargsnfs=setenv rootargs root=/dev/nfs rw nfsroot=${serverip}:${nfsrootdir},tcp,nolock rw ip=${ipaddr}:${serverip}:${gatewayip}:${netmask}:${board_name}:eth1:none
rootfs_size=0xEC00000
rootfsupd=lcd_print "Updating rootfs...";tftpboot $loadaddr_rootfs_chk ${tftpdir}rootfs.ubi.md5;if test $? -ne 0; then run fail; exit; fi;tftpboot $loadaddr ${tftpdir}rootfs.ubi;if test $? -ne 0; then run fail; exit; fi;md5sum -v $loadaddr $filesize *$loadaddr_rootfs_chk;if test $? -ne 0; then run fail; exit; fi;nand set_partition_offset $nand_pt_addr_fs;nand erase.spread $nand_pt_addr_fs $nand_pt_size_fs;nand write $loadaddr $nand_pt_addr_fs $filesize;nand set_partition_offset $nand_pt_addr_al_boot;echo rootfsupd done;lcd_print "Done"
seattle_flash_erase=nand set_partition_offset $primary_offset ; nand erase $primary_offset $rootfs_size;nand set_partition_offset $default_image_offset ; nand erase $default_image_offset $rootfs_size
secondary_offset=0xEF80000
secondary_part_erase=nand set_partition_offset $secondary_offset ; nand erase $secondary_offset $rootfs_size
serverip=192.168.1.10
set_bootargs=run set_bootargs_$unitModel ; saveenv
set_bootargs_L30=setenv bootargs mv_net_config=7,($(lan1_mac_addr),1)($(dmz_mac_addr),8)($(lan2_mac_addr),2)($(lan3_mac_addr),3)($(lan4_mac_addr),5)($(lan5_mac_addr),6)($(lan6_mac_addr),7),mtu=1500 console=ttyS0,115200 $(cp_quiet) mtdparts=nand_mtd:640k(u-boot)ro,384k(bootldr-env),8m(kernel-1),86m(rootfs-1),8m(kernel-2),86m(rootfs-2),94m(default_sw),94m(images_back),16m(config-back),23m(logs),-(storage)
set_bootargs_L50=setenv bootargs cp_net_config=2,($(lan1_mac_addr))($(dmz_mac_addr)),mtu=1500 console=$(cp_console_str) $(cp_quiet) blkdevparts=mmcblk0:10M(boot)ro,512K(bootldr-env),32M@11M(kernel-1),480M(rootfs-1),32M(kernel-2),480M(rootfs-2),200M(default_sw),650M(logs),1M(preset_cfg),1M(adsl),1000M(storage) noExtPorts=${noExtPorts} 
set_bootargs_L60i=setenv bootargs cp_net_config=2,($(lan1_mac_addr))($(dmz_mac_addr)),mtu=1500 console=$(cp_console_str) $(cp_quiet) blkdevparts=mmcblk0:10M(boot)ro,512K(bootldr-env),32M@11M(kernel-1),480M(rootfs-1),32M(kernel-2),480M(rootfs-2),200M(default_sw),650M(logs),1M(preset_cfg),1M(adsl),1000M(storage) noExtPorts=${noExtPorts} 
set_bootargs_L61i=setenv bootargs cp_net_config=2,($(lan1_mac_addr))($(dmz_mac_addr)),mtu=1500 console=$(cp_console_str) $(cp_quiet) blkdevparts=mmcblk0:10M(boot)ro,512K(bootldr-env),32M@11M(kernel-1),480M(rootfs-1),32M(kernel-2),480M(rootfs-2),200M(default_sw),650M(logs),1M(preset_cfg),1M(adsl),1000M(storage) noExtPorts=${noExtPorts} 
set_bootargs_L64i=setenv bootargs cp_net_config=2,($(lan1_mac_addr))($(dmz_mac_addr)),mtu=1500 console=$(cp_console_str) $(cp_quiet) blkdevparts=mmcblk0:10M(boot)ro,512K(bootldr-env),32M@11M(kernel-1),480M(rootfs-1),32M(kernel-2),480M(rootfs-2),200M(default_sw),650M(logs),1M(preset_cfg),1M(adsl),1000M(storage) noExtPorts=${noExtPorts} 
set_bootcmd_normal=setenv bootcmd "run tf1_image$activePartition "; saveenv
set_bootcmd_recover=setenv bootcmd run recover_boot ; saveenv
set_bootcmd_return_default=setenv bootcmd "run return_to_default bootImage" ; saveenv
set_mmc_internal=mmc dev 1
set_recover_flags=setenv recoverFlag 1 ; setenv upgradeFlag 0
skip_eth_halt=0
soc=alpine
storage_erase=setenv format_fs_parts 1; saveenv; nand set_partition_offset $storage_offset; nand erase $storage_offset $storage_size
storage_offset=0x6A180000
storage_size=0x15E80000
sub_hw_ver=ANP
sw_leds_progress=switch_leds progress
sw_leds_reset=switch_leds reset
switch_active=run switch_active_from_$activePartition
switch_active_from_1=setenv activePartition 2 ; saveenv
switch_active_from_2=setenv activePartition 1 ; saveenv
switch_config=run switch_config_from_$activeConfig
switch_config_from_1=setenv activeConfig 2 ; saveenv
switch_config_from_2=setenv activeConfig 1 ; saveenv
test=echo this is a test!
tf1_image1=boot_init_before_kernel ; run bootargsnand; nand set_partition_offset $primary_offset ; nand read.e $loadaddr $primary_offset $kernel_size; bootm $loadaddr_payload - $fdtaddr
tf1_image2=boot_init_before_kernel ; run bootargsnand; nand set_partition_offset $secondary_offset ; nand read.e $loadaddr $secondary_offset $kernel_size; bootm $loadaddr_payload - $fdtaddr
tftpdir=/
tmp_dir_size=20
uncomp_img_size=CP_IMAGE_UNCOMPRESSED_SIZE
unitModel=L72
unitName=UTM1
unitVer=1
upgradeFlag=0
upgrade_boot=run switch_active ; run set_bootcmd_recover ; setenv upgradeFlag 1 ; saveenv ; run tf1_image$activePartition
vendor=annapurna-labs
write_default_to_primary=setenv activePartition 1 ; setenv activeConfig 1 ; nand set_partition_offset $primary_offset ; nand write.e $loadaddr $primary_offset $default_image_size
mtc_mode_rst_cnt=0
